# ============================================================
# Variáveis de ambiente — MyRebanho Site
# ------------------------------------------------------------
# Local:   copie para .env.local e preencha (NUNCA comite o .env.local)
# AWS:     CloudFront/S3 não executa código server-side; todas as vars
#          precisam do prefixo NEXT_PUBLIC_ para serem embutidas no bundle.
# ============================================================

# --- FIREBASE Web SDK (identificadores públicos — não são segredos) --------
# Console Firebase → engrenagem → Configurações do projeto → Seus apps
# → Web app → SDK config (escolha "Config", não "Service Account").
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Coleção do Firestore onde os leads são salvos
NEXT_PUBLIC_FIRESTORE_LEADS_COLLECTION=leads_site

# IMPORTANTE — Firestore Security Rules (configurar no console Firebase):
# rules_version = '2';
# service cloud.firestore {
#   match /databases/{database}/documents {
#     match /leads/{doc} {
#       allow create: if true;   // site pode criar
#       allow read, update, delete: if false;  // nunca pelo client
#     }
#   }
# }

# --- HUBSPOT Forms Submission API (endpoint público — sem token privado) ---
# 1. HubSpot → Marketing → Forms → Criar um form com os campos:
#    email, firstname, lastname, phone, tamanho_rebanho, tipo_operacao
# 2. Após criar, abra o form → Share → Embed: copie o portalId e formId.
NEXT_PUBLIC_HUBSPOT_PORTAL_ID=47673728
NEXT_PUBLIC_HUBSPOT_FORM_GUID=
# Deixe NEXT_PUBLIC_HUBSPOT_FORM_GUID vazio para desabilitar o envio ao HubSpot.
